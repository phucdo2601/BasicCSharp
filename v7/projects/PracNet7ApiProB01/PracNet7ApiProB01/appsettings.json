      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=p-net7-web-api-pro-2024-b01-dev-db;Username=postgres;Password=12345678"
  },
