@model Category

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Create category page</h2>
            <hr/>
        </div>
        <div asp-validation-summary="ModelOnly"></div>
        <div class="mb-3 row p-1">
            <label for="categoryName" asp-for="Name" class="p-0"></label>
            <input type="text" class="form-control" id="categoryName" asp-for="Name"/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div
        <div class="mb-3 row p-1">
            <label for="displayOrder" asp-for="DisplayOrder" class="p-0"></label>
            <input type="text" class="form-control" id="displayOrder" asp-for="DisplayOrder" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-6">
                <button type="submit" class="btn btn-success form-control">Submit</button>
            </div>
            <div class="col-6">
                <a asp-action="Index" asp-controller="Category" class="btn btn-secondary form-control">
                    Back
                </a>
            </div>
        </div>
    </div>

</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
